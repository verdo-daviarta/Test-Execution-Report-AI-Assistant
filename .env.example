# OPENAI_API_KEY: Required for OpenAI API calls. Leave empty to use the local fallback.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_MODEL="gemini-2.0-flash"
AI_PROVIDER="openai"
# Optional internal API key. When set, clients must send x-api-key.
INTERNAL_API_KEY=""
# Optional browser-side value for local/internal deployments only.
VITE_INTERNAL_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
